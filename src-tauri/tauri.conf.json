{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimage",
  "mainBinaryName": "Minimage",
  "version": "0.1.0",
  "identifier": "com.utilsware.minimage",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Minimage",
        "width": 1320,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Utilsware",
    "publisher": "Utilsware",
    "category": "Productivity",
    "shortDescription": "Batch image resizer, converter and optimizer",
    "longDescription": "Minimage lets you resize, convert and optimize images in bulk. Build a matrix of sizes × formats, annotate, compare before/after, and export with templated file names."
  },
  "plugins": {}
}
