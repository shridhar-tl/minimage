# syntax=docker/dockerfile:1
# Cross-compiles the Windows installer on Linux via cargo-xwin + NSIS, so you can
# build the app without installing Rust / MSVC / Node on the host.
#
# BuildKit cache mounts persist the cargo registry, the compiled target/ dir, the
# cargo-xwin SDK and the npm cache across builds — so after the first (cold) build,
# a source-only change recompiles only what changed (~1-3 min instead of ~15).
#
#   docker compose run --build --rm windows-build
#   # → installer + exe land in ./release
#
# The primary, fully-validated build path is GitHub Actions (windows-latest) —
# see .github/workflows/build.yml. This image is a local convenience.
FROM rust:1-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      clang llvm lld nsis tar curl ca-certificates xz-utils git \
    && rm -rf /var/lib/apt/lists/*

# Node 20 (npm)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Windows MSVC target + cross tooling (cached crate downloads).
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    rustup target add x86_64-pc-windows-msvc \
    && cargo install cargo-xwin --locked \
    && cargo install tauri-cli --version "^2" --locked

WORKDIR /app
COPY . .

# Install JS deps + build the frontend (npm download cache persists across builds).
RUN --mount=type=cache,target=/root/.npm \
    npm install --force && npm run build

# Build + bundle. The cache mounts make recompiles incremental; because a cache
# mount is unmounted when the RUN ends, the artifacts are copied into a real
# folder (/artifacts) inside the same RUN so they survive into the image.
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,target=/root/.cache/cargo-xwin \
    --mount=type=cache,target=/app/src-tauri/target,sharing=locked \
    set -eux; \
    export CL="-mssse3 -msse4.1 -msse4.2"; \
    cargo tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis --features webp-lossy; \
    mkdir -p /artifacts; \
    # Copy by exact product name, not *.exe — the target/ cache mount is reused
    # across builds and may still hold artifacts from a previous product name
    # (e.g. an old rename), which a wildcard would scoop up as stale duplicates.
    PRODUCT="$(node -p "require('./src-tauri/tauri.conf.json').productName")"; \
    cp -v "src-tauri/target/x86_64-pc-windows-msvc/release/${PRODUCT}.exe" /artifacts/; \
    cp -v src-tauri/target/x86_64-pc-windows-msvc/release/bundle/nsis/"${PRODUCT}"_*-setup.exe /artifacts/; \
    ls -la /artifacts

CMD ["bash", "-c", "mkdir -p /out; rm -f /out/*.exe 2>/dev/null || true; cp -vf /artifacts/*.exe /out/ && ls -la /out"]
